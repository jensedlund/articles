@article{langfeldJudgmentEmotionsFacial1918,
  title = {The judgment of emotions from facial expressions},
  author = {Langfeld, Herbert Sidney},
  date = {1918},
  journaltitle = {The Journal of Abnormal Psychology},
  volume = {13},
  pages = {172--184},
  publisher = {American Psychological Association},
  location = {US},
  issn = {0145-2339},
  doi = {10.1037/h0070231},
  abstract = {Tested the ability to read emotional expressions. 105 pictures of different facial expressions were shown to 6 Ss, who interpreted the emotions portrayed. To discover the degree of constancy, all the pictures were shown again, in a different order. The Ss were then told the judgment of all the Ss and the book titles of the pictures, to discover if they recognized their own judgments. Finally, they were asked to describe the method by which they interpreted the experiment. The reports and introspections have been provided. Results reveal that the Ss were fairly consistent; did not frequently recognize their own judgments; and there were typical differences in their ability to judge expressions. The reports show that they obtained their results by kinesthetic imitation; by association with known experiences; and by imagining situations which would give rise to such emotions. Introspections indicate the importance of the surroundings. (PsycInfo Database Record (c) 2021 APA, all rights reserved)},
  keywords = {Face Perception,Facial Expressions,Judgment},
  file = {C:\Users\Jens Edlund\Zotero\storage\CMK44J4Z\Langfeld - 1918 - The judgment of emotions from facial expressions.pdf}
}

