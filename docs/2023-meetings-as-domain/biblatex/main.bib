@article{jacobsConferencesLearningCommunities2005,
  title = {Conferences as learning communities: some early lessons in using ‘back-channel’ technologies at an academic conference – distributed intelligence or divided attention?},
  shorttitle = {Conferences as learning communities},
  author = {Jacobs, N. and McFarlane, A.},
  date = {2005},
  journaltitle = {Journal of Computer Assisted Learning},
  volume = {21},
